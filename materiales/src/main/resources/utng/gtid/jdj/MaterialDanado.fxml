<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>


<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="utng.gtid.jdj.controller.MaterialDanadoController">


    <VBox spacing="10"
          layoutX="20"
          layoutY="20">


        <Label text="Registro de Materiales Dañados"
               style="-fx-font-size:18px;"/>


        <HBox spacing="10">

            <VBox spacing="5">

                <Label text="Material"/>

                <ComboBox fx:id="cbMaterial"
                          prefWidth="200"/>

            </VBox>


            <VBox spacing="5">

                <Label text="Fecha Reporte"/>

                <DatePicker fx:id="dpFecha"/>

            </VBox>

        </HBox>



        <VBox spacing="5">

            <Label text="Tipo de daño"/>

            <ComboBox fx:id="cbTipoDanio"
                      prefWidth="250"/>

        </VBox>



        <VBox spacing="5">

            <Label text="Descripción"/>

            <TextArea fx:id="txtDescripcion"
                      prefWidth="300"
                      prefHeight="70"/>

        </VBox>



        <VBox spacing="5">

            <Label text="Estado"/>

            <ComboBox fx:id="cbEstado"
                      prefWidth="200"/>

        </VBox>



        <VBox spacing="5">

            <Label text="Observaciones"/>

            <TextArea fx:id="txtObservaciones"
                      prefWidth="300"
                      prefHeight="70"/>

        </VBox>



        <HBox spacing="10">

            <Button text="Guardar"
                    onAction="#guardar"/>

            <Button text="Actualizar"
                    onAction="#actualizar"/>

            <Button text="Eliminar"
                    onAction="#eliminar"/>

            <Button text="Limpiar"
                    onAction="#limpiar"/>

        </HBox>



        <TableView fx:id="tablaMaterialDanado"
                   prefWidth="700"
                   prefHeight="250">


            <columns>

                <TableColumn fx:id="colId"
                             text="ID"/>

                <TableColumn fx:id="colMaterial"
                             text="Material"/>

                <TableColumn fx:id="colFecha"
                             text="Fecha"/>

                <TableColumn fx:id="colTipo"
                             text="Tipo Daño"/>

                <TableColumn fx:id="colEstado"
                             text="Estado"/>

            </columns>


        </TableView>


    </VBox>


</AnchorPane>